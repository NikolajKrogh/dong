{
  "name": "dong",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "auth:env": "node ./scripts/bootstrap-supabase-env.mjs",
    "android": "expo run:android",
    "android:tunnel": "adb reverse tcp:8080 tcp:8080",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci",
    "lint": "eslint .",
    "bdd:gen": "bddgen",
    "test:e2e": "bddgen && playwright test --config=playwright.config.ts",
    "test:e2e:home": "playwright test --config=playwright.home.config.ts",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "db:new-migration": "npx supabase migration new",
    "db:status": "npx supabase status"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/playwright/",
      "/\\.features-gen/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|tamagui|@tamagui))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.114.0",
    "@tamagui/animations-react-native": "^2.7.7",
    "dayjs": "^1.11.23",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "image-size": "^2.0.2",
    "js-base64": "^3.9.3",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-date-picker": "^5.0.10",
    "react-native-dropdown-select-list": "^2.0.5",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.5.0",
    "react-native-ui-datepicker": "^3.0.7",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.62.1",
    "@tamagui/babel-plugin": "^2.7.7",
    "@tamagui/cli": "^2.7.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "playwright-bdd": "^9.2.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
