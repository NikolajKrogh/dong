# Copy to .env and fill in. NEVER commit the real .env (see root .gitignore).
#
# `command-api/.env` is loaded automatically by Spring Boot (spring.config.import
# in application.yml) — nothing needs exporting into your shell. Because it is
# read as a Java .properties file:
#   * do NOT quote values — "https://x" would include the quote characters
#   * '#' begins a comment; the first '=' separates key from value
#
# Real environment variables outrank this file, so a value exported in the shell
# or injected by a container orchestrator still wins. This is a local default,
# not an override.
#
# SUPABASE_ANON_KEY is required against a hosted project: Supabase's gateway
# answers 401 "No API key found in request" without it, which leaves the
# 'supabase' health component DOWN. Copy it from the root .env.local
# (EXPO_PUBLIC_SUPABASE_ANON_KEY) or the dashboard.
SUPABASE_ANON_KEY=

# SUPABASE_JWKS_URL — JSON Web Key Set endpoint used to verify the signature
#   of Supabase-issued JWTs against its published asymmetric JWT Signing Keys.
#   No shared secret is held by this service (https://supabase.com/docs/guides/auth/signing-keys).
#   Cloud: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#   Local: the Supabase CLI serves an ES256 key set out of the box — no
#   signing_keys_path config needed. Port comes from supabase/config.toml [api].
#   Absence is intentional fail-closed: the service refuses to start.
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json

# SUPABASE_URL — base URL of the Supabase project (used by the health indicator).
#   Local Supabase, per supabase/config.toml [api] port:
SUPABASE_URL=http://127.0.0.1:55321

# spring.profiles.active — activate the dev profile locally, which is the only
#   thing that enables CORS for the Expo web dev server (application-dev.yml).
#   Without it the web build's fetches are rejected by the browser and surface as
#   an opaque "NetworkError". CI and prod have no .env, so CORS stays off there.
#   Setting it here means `./mvnw.cmd spring-boot:run` needs no profile flag.
spring.profiles.active=dev

# COMMAND_API_MATCH_DISCOVERY_TTL — optional cache TTL for identical match lookups.
#   Default comes from application.yml: PT5M
COMMAND_API_MATCH_DISCOVERY_TTL=PT5M

# COMMAND_API_MATCH_DISCOVERY_ESPN_BASE_URL — optional ESPN soccer API base URL.
#   Default comes from application.yml and should only change for testing or proxying.
COMMAND_API_MATCH_DISCOVERY_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer
